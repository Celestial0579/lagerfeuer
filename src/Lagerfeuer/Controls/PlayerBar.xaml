<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lagerfeuer.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lagerfeuer.Controls">

    <UserControl.Resources>
        <Style x:Key="PlayerButton" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid
        Padding="12,8"
        Background="{ThemeResource LfSurfaceBrush}"
        BorderBrush="{ThemeResource LfLineBrush}"
        BorderThickness="0,1,0,0"
        ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" MaxWidth="320" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Cover + Titel (klickbar → Buchseite)  -->
        <Button
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Click="OnOpenItem"
            ToolTipService.ToolTip="Buch öffnen">
            <controls:CoverImage Width="64" Height="64" DecodeWidth="64" ItemId="{x:Bind Player.ItemId, Mode=OneWay}" />
        </Button>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Style="{StaticResource LfBookTitleStyle}" Text="{x:Bind Player.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Player.Author, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Player.ChapterTitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!--  Steuerung + Zeitleiste  -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                <Button Click="OnPreviousChapter" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Vorheriges Kapitel">
                    <FontIcon Glyph="&#xE892;" />
                </Button>
                <Button Click="OnBack" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="10 Sekunden zurück">
                    <FontIcon Glyph="&#xED3C;" />
                </Button>
                <Button
                    Width="48"
                    Height="48"
                    Click="OnPlayPause"
                    CornerRadius="24"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Wiedergabe/Pause (Leertaste)">
                    <Grid>
                        <FontIcon Glyph="{x:Bind PlayGlyph(Player.IsPlaying), Mode=OneWay}" Visibility="{x:Bind CollapsedIf(Player.IsBuffering), Mode=OneWay}" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            IsActive="{x:Bind Player.IsBuffering, Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button Click="OnForward" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="30 Sekunden vor">
                    <FontIcon Glyph="&#xED3D;" />
                </Button>
                <Button Click="OnNextChapter" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Nächstes Kapitel">
                    <FontIcon Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    MinWidth="56"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind FormatTime(Player.Position), Mode=OneWay}"
                    TextAlignment="Right" />
                <Grid Grid.Column="1">
                    <!--  Cache-Fortschritt des aktuellen Tracks  -->
                    <ProgressBar
                        Margin="0,0,0,-14"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Opacity="0.35"
                        ToolTipService.ToolTip="Zwischengespeichert"
                        Value="{x:Bind Player.CachedFraction, Mode=OneWay}" />
                    <Slider
                        x:Name="PositionSlider"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="True"
                        Maximum="{x:Bind Player.Duration, Mode=OneWay}"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="OnSliderValueChanged" />
                </Grid>
                <TextBlock
                    Grid.Column="2"
                    MinWidth="56"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind FormatRemaining(Player.Position, Player.Duration), Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <!--  Geschwindigkeit, Sleep-Timer, Lautstärke, Schließen  -->
        <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
            <DropDownButton Content="{x:Bind FormatRate(Player.PlaybackRate), Mode=OneWay}" ToolTipService.ToolTip="Geschwindigkeit">
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="RateFlyout" Placement="Top" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <DropDownButton ToolTipService.ToolTip="Sleep-Timer">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE708;" />
                    <TextBlock Text="{x:Bind Player.SleepTimerText, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem Click="OnSleep" Tag="0" Text="Aus" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnSleep" Tag="5" Text="5 Minuten" />
                        <MenuFlyoutItem Click="OnSleep" Tag="15" Text="15 Minuten" />
                        <MenuFlyoutItem Click="OnSleep" Tag="30" Text="30 Minuten" />
                        <MenuFlyoutItem Click="OnSleep" Tag="45" Text="45 Minuten" />
                        <MenuFlyoutItem Click="OnSleep" Tag="60" Text="60 Minuten" />
                        <MenuFlyoutItem Click="OnSleep" Tag="chapter" Text="Ende des Kapitels" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Lautstärke">
                <FontIcon Glyph="&#xE767;" />
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Slider
                            Width="200"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="0.01"
                            Value="{x:Bind Player.Volume, Mode=TwoWay}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Click="OnAddBookmark" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Lesezeichen an dieser Stelle setzen">
                <FontIcon Glyph="&#xE8A4;" />
            </Button>
            <Button Click="OnMiniPlayer" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Mini-Player (immer im Vordergrund)">
                <FontIcon Glyph="&#xE944;" />
            </Button>
            <Button Click="OnStop" Style="{StaticResource PlayerButton}" ToolTipService.ToolTip="Wiedergabe beenden">
                <FontIcon Glyph="&#xE711;" />
            </Button>
        </StackPanel>
    </Grid>

</UserControl>
