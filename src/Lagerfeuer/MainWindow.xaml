<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lagerfeuer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lagerfeuer.Controls"
    Title="Lagerfeuer">

    <Grid x:Name="RootGrid" Background="{ThemeResource LfBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Eigene Titelleiste  -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image Width="22" Height="22" Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource LfSerifFont}"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource LfHeadingBrush}"
                    Text="Lagerfeuer" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
        <!--  Offline-Hinweis  -->
        <InfoBar
            x:Name="OfflineBar"
            Title="Offline"
            Margin="12,0,12,8"
            IsClosable="False"
            IsOpen="False"
            Message="Der Server ist nicht erreichbar. Heruntergeladene Bücher kannst du weiter hören – gehörte Zeit wird später übertragen."
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button x:Name="ReconnectButton" Click="OnReconnect" Content="Erneut verbinden" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Update-Hinweis (GitHub-Releases)  -->
        <InfoBar
            x:Name="UpdateBar"
            Margin="12,0,12,8"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button
                    x:Name="UpdateButton"
                    Click="OnInstallUpdate"
                    Content="Jetzt aktualisieren"
                    Style="{StaticResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="12">
                    <HyperlinkButton x:Name="ReleaseNotesLink" Content="Was ist neu?" />
                    <HyperlinkButton x:Name="SkipUpdateLink" Click="OnSkipUpdate" Content="Diese Version überspringen" />
                    <ProgressBar
                        x:Name="UpdateProgress"
                        Width="200"
                        VerticalAlignment="Center"
                        Maximum="1"
                        Visibility="Collapsed" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>
        </StackPanel>

        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            BackRequested="OnBackRequested"
            IsBackButtonVisible="Auto"
            IsSettingsVisible="False"
            ItemInvoked="OnNavItemInvoked"
            PaneDisplayMode="Left"
            Visibility="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Weiterhören" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DownloadsItem" Content="Downloads" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="LibrariesHeader" Content="Bibliotheken" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" Content="Einstellungen" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="LogoutItem"
                    Content="Abmelden"
                    SelectsOnInvoked="False"
                    Tag="logout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF3B1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Navigated="OnContentNavigated" />
        </NavigationView>

        <Frame x:Name="LoginFrame" Grid.Row="2" />

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="2"
            MaxWidth="720"
            Margin="24"
            VerticalAlignment="Bottom"
            IsOpen="False"
            Severity="Error" />

        <controls:PlayerBar
            x:Name="PlayerBar"
            Grid.Row="3"
            OpenItemRequested="OnOpenItemRequested"
            Visibility="{x:Bind Player.HasSession, Mode=OneWay}" />
    </Grid>
</Window>
