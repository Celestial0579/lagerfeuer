<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lagerfeuer.Views.AuthorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lagerfeuer.Controls"
    xmlns:vm="using:Lagerfeuer.ViewModels">

    <Grid>
        <ScrollViewer x:Name="ContentRoot" Visibility="Collapsed">
            <StackPanel MaxWidth="1200" Padding="32,16,32,32" Spacing="20">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:CoverImage
                        x:Name="Portrait"
                        Width="140"
                        Height="140"
                        VerticalAlignment="Top"
                        CornerRadius="70"
                        DecodeWidth="140" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Name="NameText" Style="{StaticResource LfTitleLargeStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="InfoText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="DescriptionText"
                            MaxWidth="800"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            MaxLines="8"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="SeriesPanel" Spacing="8" />

                <TextBlock Style="{StaticResource LfSubtitleStyle}" Text="Alle Bücher" />
                <GridView
                    x:Name="BooksGrid"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BookItemViewModel">
                            <controls:BookTile Item="{x:Bind}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
        <ProgressRing x:Name="LoadingRing" IsActive="True" />
    </Grid>
</Page>
