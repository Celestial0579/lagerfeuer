<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lagerfeuer.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Border
            Width="420"
            Margin="24,48"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource LfSurfaceBrush}"
            BorderBrush="{ThemeResource LfLineBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Width="44" Height="44" Source="ms-appx:///Assets/AppIcon.png" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource LfTitleStyle}" Text="Lagerfeuer" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Hörbücher aus deinem Audiobookshelf. Melde dich bei deinem Server an."
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="MessageBar" IsClosable="False" IsOpen="False" Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button x:Name="RetryButton" Click="OnRetry" Content="Erneut versuchen" Visibility="Collapsed" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--  Schritt 1: Server  -->
                <TextBox
                    x:Name="ServerBox"
                    Header="Server-Adresse"
                    InputScope="Url"
                    KeyDown="OnServerKeyDown"
                    PlaceholderText="https://abs.example.com"
                    TextChanged="OnServerTextChanged" />
                <Button
                    x:Name="ConnectButton"
                    HorizontalAlignment="Stretch"
                    Click="OnConnect"
                    Content="Weiter"
                    Style="{StaticResource AccentButtonStyle}" />

                <!--  Schritt 2: Anmeldemethoden  -->
                <StackPanel x:Name="AuthPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock
                        x:Name="ServerInfoText"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <Button
                        x:Name="SsoButton"
                        HorizontalAlignment="Stretch"
                        Click="OnSsoLogin"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8D7;" />
                            <TextBlock x:Name="SsoButtonText" Text="Mit SSO anmelden" />
                        </StackPanel>
                    </Button>

                    <InfoBar
                        x:Name="SsoWaitBar"
                        Title="Anmeldung im Browser"
                        IsClosable="False"
                        IsOpen="False"
                        Message="Bitte schließe die Anmeldung in deinem Browser ab. Danach geht es hier automatisch weiter."
                        Severity="Informational">
                        <InfoBar.Content>
                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                                <Button Click="OnReopenBrowser" Content="Browser erneut öffnen" />
                                <Button Click="OnCancelSso" Content="Abbrechen" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>

                    <StackPanel x:Name="LocalPanel" Spacing="12">
                        <Grid x:Name="OrSeparator" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="oder" />
                            <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Grid>
                        <TextBox x:Name="UserBox" Header="Benutzername" />
                        <PasswordBox x:Name="PasswordBox" Header="Passwort" KeyDown="OnPasswordKeyDown" />
                        <Button
                            x:Name="LoginButton"
                            HorizontalAlignment="Stretch"
                            Click="OnLocalLogin"
                            Content="Anmelden" />
                    </StackPanel>
                </StackPanel>

                <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
