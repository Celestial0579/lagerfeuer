<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lagerfeuer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="32,16,32,32" HorizontalAlignment="Left" Spacing="16">
            <TextBlock Style="{StaticResource LfTitleStyle}" Text="Einstellungen" />

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Konto" />
            <TextBlock x:Name="AccountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Angemeldete Geräte" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Geräte und Browser, die mit deinem Konto angemeldet sind. Abgemeldete Geräte müssen sich neu anmelden (spätestens nach einer Stunde)."
                TextWrapping="Wrap" />
            <ListView x:Name="SessionList" SelectionMode="None" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="OnRefreshSessions" Content="Aktualisieren" />
                <Button Click="OnLogoutAllDevices" Content="Auf allen Geräten abmelden" />
            </StackPanel>

            <TextBlock Margin="0,16,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Audio-Cache" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Hörbücher werden beim Streamen auf der Festplatte zwischengespeichert. Bereits geladene Teile werden nicht erneut übertragen. Ist das Limit erreicht, werden die am längsten nicht gehörten Bücher entfernt."
                TextWrapping="Wrap" />
            <NumberBox
                x:Name="CacheLimitBox"
                Width="220"
                HorizontalAlignment="Left"
                Header="Maximale Cache-Größe (GB)"
                Maximum="2000"
                Minimum="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnCacheLimitChanged" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="CacheSizeText" VerticalAlignment="Center" />
                <Button Click="OnClearCache" Content="Cache leeren" />
                <Button Click="OnOpenFolder" Content="Ordner öffnen" />
            </StackPanel>

            <TextBlock Margin="0,16,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Anrufe" />
            <ToggleSwitch
                x:Name="PauseOnCallsSwitch"
                Header="Bei Anrufen automatisch pausieren"
                OffContent="Aus"
                OnContent="An"
                Toggled="OnPauseOnCallsToggled" />
            <CheckBox x:Name="ResumeAfterCallsBox" Click="OnResumeAfterCallsClicked" Content="Nach dem Anruf automatisch weiterhören" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Erkennt Anrufe in Teams, Zoom, Telefon-Link und anderen Apps, die Windows als Kommunikation melden. Voraussetzung: In den Windows-Soundeinstellungen (Systemsteuerung → Sound → Kommunikation) ist nicht „Nichts unternehmen“ ausgewählt."
                TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Updates" />
            <ToggleSwitch
                x:Name="AutoUpdateSwitch"
                Header="Automatisch nach Updates suchen"
                OffContent="Aus"
                OnContent="An"
                Toggled="OnAutoUpdateToggled" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="CheckUpdateButton" Click="OnCheckUpdates" Content="Jetzt nach Updates suchen" />
                <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Margin="0,16,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Info" />
            <TextBlock x:Name="InfoText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Click="OnOpenLog" Content="Log öffnen" ToolTipService.ToolTip="Für Fehlerberichte: Protokoll der App anzeigen" />
                <HyperlinkButton Content="Fehler melden" NavigateUri="https://github.com/Celestial0579/lagerfeuer/issues/new/choose" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
