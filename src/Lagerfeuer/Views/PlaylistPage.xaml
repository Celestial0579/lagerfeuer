<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lagerfeuer.Views.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lagerfeuer.Controls"
    xmlns:local="using:Lagerfeuer.Views">

    <Grid>
        <Grid x:Name="ContentRoot" Padding="32,16,32,0" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Style="{StaticResource LfTitleStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="DescriptionText"
                Grid.Row="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="4"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="PlayButton" Click="OnPlayAll" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="Alle abspielen" />
                    </StackPanel>
                </Button>
                <Button x:Name="DownloadButton" Click="OnDownload" ToolTipService.ToolTip="Alle Bücher der Liste in die Downloads legen">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE896;" />
                        <TextBlock Text="Liste herunterladen" />
                    </StackPanel>
                </Button>
                <Button Click="OnRename">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                        <TextBlock Text="Umbenennen" />
                    </StackPanel>
                </Button>
                <Button Click="OnDelete">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Liste löschen" />
                    </StackPanel>
                </Button>
                <TextBlock
                    x:Name="CountText"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!--  Reihenfolge per Ziehen, per Knöpfe und per Kontextmenü (Umschalt+F10), damit es auch ohne Maus geht.  -->
            <ListView
                x:Name="List"
                Grid.Row="3"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="OnDragItemsCompleted"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PlaylistEntry">
                        <Grid Padding="0,8" Background="Transparent" ColumnSpacing="16">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnPlayFrom" Tag="{x:Bind}" Text="Ab hier abspielen" />
                                    <MenuFlyoutItem Click="OnMoveUp" Tag="{x:Bind}" Text="Nach oben" />
                                    <MenuFlyoutItem Click="OnMoveDown" Tag="{x:Bind}" Text="Nach unten" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="OnRemove" Tag="{x:Bind}" Text="Aus der Liste entfernen" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:CoverImage Width="56" Height="56" DecodeWidth="56" ItemId="{x:Bind CoverId}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Opacity="{x:Bind TextOpacity}">
                                <TextBlock Style="{StaticResource LfBookTitleStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Subtitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                <Button
                                    AutomationProperties.Name="Ab hier abspielen"
                                    Click="OnPlayFrom"
                                    IsEnabled="{x:Bind IsAvailable}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Ab hier abspielen">
                                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                                </Button>
                                <Button AutomationProperties.Name="Nach oben" Click="OnMoveUp" Tag="{x:Bind}" ToolTipService.ToolTip="Nach oben">
                                    <FontIcon FontSize="14" Glyph="&#xE70E;" />
                                </Button>
                                <Button AutomationProperties.Name="Nach unten" Click="OnMoveDown" Tag="{x:Bind}" ToolTipService.ToolTip="Nach unten">
                                    <FontIcon FontSize="14" Glyph="&#xE70D;" />
                                </Button>
                                <Button AutomationProperties.Name="Aus der Liste entfernen" Click="OnRemove" Tag="{x:Bind}" ToolTipService.ToolTip="Aus der Liste entfernen">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <ProgressRing x:Name="LoadingRing" IsActive="True" />
    </Grid>
</Page>
