<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lagerfeuer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lagerfeuer.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Farben nach firestrike-branding (Tokens 1.2.0): Die Rollen heißen wie im WinUI-Export (FsGrundColor …),
                die Akzentreihe ist die des Exports. Die CI gleicht beides mit `marke.py abgleichen` ab (#68). Neue Werte
                kommen aus firestrike-branding, zusammen mit dessen Commit in .github/workflows/ci.yml.
                Glut seit 0.2.8 etwas kräftiger, damit sie als Text auf jeder Fläche WCAG AA (4,5:1) erreicht (#66).
                Überschriften in Stahl tief, Glut nur für Verweise und Akzente (#67).
                Im Kontrastdesign zeigen alle Rollen und Pinsel auf Systemfarben wie im Export, die Akzentreihe bleibt die
                des Systems (#93). Die Pinsel nehmen dort ThemeResource, damit sie einem Wechsel des Kontrastdesigns folgen.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#A24C18</Color>
                    <Color x:Key="SystemAccentColorLight1">#CF6028</Color>
                    <Color x:Key="SystemAccentColorLight2">#DB7745</Color>
                    <Color x:Key="SystemAccentColorLight3">#F2B558</Color>
                    <Color x:Key="SystemAccentColorDark1">#A24C18</Color>
                    <Color x:Key="SystemAccentColorDark2">#A24C18</Color>
                    <Color x:Key="SystemAccentColorDark3">#7E3B13</Color>

                    <Color x:Key="FsGrundColor">#EFF0ED</Color>
                    <Color x:Key="FsFlaecheColor">#FFFFFF</Color>
                    <Color x:Key="FsFlaecheTiefColor">#E3E5E1</Color>
                    <Color x:Key="FsLinieColor">#C9CCC6</Color>
                    <Color x:Key="FsTextColor">#1B1E1C</Color>
                    <Color x:Key="FsTextLeiseColor">#5A605B</Color>
                    <Color x:Key="FsStahlTiefColor">#212B33</Color>
                    <Color x:Key="FsGlutColor">#A24C18</Color>
                    <Color x:Key="FsFunkeColor">#E8A33D</Color>

                    <SolidColorBrush x:Key="LfBackgroundBrush" Color="{StaticResource FsGrundColor}" />
                    <SolidColorBrush x:Key="LfSurfaceBrush" Color="{StaticResource FsFlaecheColor}" />
                    <SolidColorBrush x:Key="LfSurfaceDeepBrush" Color="{StaticResource FsFlaecheTiefColor}" />
                    <SolidColorBrush x:Key="LfLineBrush" Color="{StaticResource FsLinieColor}" />
                    <SolidColorBrush x:Key="LfHeadingBrush" Color="{StaticResource FsStahlTiefColor}" />
                    <SolidColorBrush x:Key="LfEmberBrush" Color="{StaticResource FsGlutColor}" />
                    <SolidColorBrush x:Key="LfSparkBrush" Color="{StaticResource FsFunkeColor}" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource FsTextColor}" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource FsTextLeiseColor}" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource FsFlaecheColor}" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource FsLinieColor}" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#A24C18</Color>
                    <Color x:Key="SystemAccentColorLight1">#CF6028</Color>
                    <Color x:Key="SystemAccentColorLight2">#DB7745</Color>
                    <Color x:Key="SystemAccentColorLight3">#F2B558</Color>
                    <Color x:Key="SystemAccentColorDark1">#A24C18</Color>
                    <Color x:Key="SystemAccentColorDark2">#A24C18</Color>
                    <Color x:Key="SystemAccentColorDark3">#7E3B13</Color>

                    <Color x:Key="FsGrundColor">#141715</Color>
                    <Color x:Key="FsFlaecheColor">#1C201D</Color>
                    <Color x:Key="FsFlaecheTiefColor">#262B27</Color>
                    <Color x:Key="FsLinieColor">#38403A</Color>
                    <Color x:Key="FsTextColor">#E8EBE7</Color>
                    <Color x:Key="FsTextLeiseColor">#A5ADA6</Color>
                    <Color x:Key="FsStahlTiefColor">#B4C6D1</Color>
                    <Color x:Key="FsGlutColor">#DB7745</Color>
                    <Color x:Key="FsFunkeColor">#F2B558</Color>

                    <SolidColorBrush x:Key="LfBackgroundBrush" Color="{StaticResource FsGrundColor}" />
                    <SolidColorBrush x:Key="LfSurfaceBrush" Color="{StaticResource FsFlaecheColor}" />
                    <SolidColorBrush x:Key="LfSurfaceDeepBrush" Color="{StaticResource FsFlaecheTiefColor}" />
                    <SolidColorBrush x:Key="LfLineBrush" Color="{StaticResource FsLinieColor}" />
                    <SolidColorBrush x:Key="LfHeadingBrush" Color="{StaticResource FsStahlTiefColor}" />
                    <SolidColorBrush x:Key="LfEmberBrush" Color="{StaticResource FsGlutColor}" />
                    <SolidColorBrush x:Key="LfSparkBrush" Color="{StaticResource FsFunkeColor}" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource FsTextColor}" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource FsTextLeiseColor}" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource FsFlaecheColor}" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource FsLinieColor}" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="FsGrundColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="FsFlaecheColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="FsFlaecheTiefColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="FsLinieColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="FsTextColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="FsTextLeiseColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="FsStahlTiefColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="FsGlutColor" ResourceKey="SystemColorHotlightColor" />
                    <StaticResource x:Key="FsFunkeColor" ResourceKey="SystemColorHighlightColor" />

                    <SolidColorBrush x:Key="LfBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LfSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LfSurfaceDeepBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="LfLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LfHeadingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="LfEmberBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="LfSparkBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Hintergrund der Cover als ThemeResource: folgt einem Wechsel von Design und Kontrastdesign (#92)  -->
            <Style TargetType="controls:CoverImage">
                <Setter Property="Background" Value="{ThemeResource LfSurfaceDeepBrush}" />
            </Style>

            <!--  Überschriften wie auf firestrike.de: Serifenschrift (Iowan Old Style → Palatino Linotype unter Windows)  -->
            <FontFamily x:Key="LfSerifFont">Palatino Linotype, Book Antiqua, Georgia</FontFamily>

            <Style x:Key="LfTitleStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LfSerifFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource LfHeadingBrush}" />
            </Style>
            <Style x:Key="LfTitleLargeStyle" BasedOn="{StaticResource TitleLargeTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LfSerifFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource LfHeadingBrush}" />
            </Style>
            <Style x:Key="LfSubtitleStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LfSerifFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource LfHeadingBrush}" />
            </Style>
            <Style x:Key="LfBookTitleStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LfSerifFont}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
