<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lagerfeuer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Farbschema angelehnt an firestrike.de:
                Glut #AB5019 / #D9713C (Akzent), Funke #E8A33D, Stahl #33414B / #212B33 / #B4C6D1,
                Grund #EFF0ED / #141715, Fläche #FFFFFF, Linie #C9CCC6, Text #1B1E1C / #E8EBE7.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#AB5019</Color>
                    <Color x:Key="SystemAccentColorLight1">#C2602A</Color>
                    <Color x:Key="SystemAccentColorLight2">#D9713C</Color>
                    <Color x:Key="SystemAccentColorLight3">#E8A33D</Color>
                    <Color x:Key="SystemAccentColorDark1">#AB5019</Color>
                    <Color x:Key="SystemAccentColorDark2">#8E4113</Color>
                    <Color x:Key="SystemAccentColorDark3">#6E320E</Color>

                    <SolidColorBrush x:Key="LfBackgroundBrush" Color="#EFF0ED" />
                    <SolidColorBrush x:Key="LfSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LfSurfaceDeepBrush" Color="#E3E5E1" />
                    <SolidColorBrush x:Key="LfLineBrush" Color="#C9CCC6" />
                    <SolidColorBrush x:Key="LfHeadingBrush" Color="#33414B" />
                    <SolidColorBrush x:Key="LfEmberBrush" Color="#AB5019" />
                    <SolidColorBrush x:Key="LfSparkBrush" Color="#E8A33D" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1B1E1C" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5A605B" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#C9CCC6" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#AB5019</Color>
                    <Color x:Key="SystemAccentColorLight1">#C2602A</Color>
                    <Color x:Key="SystemAccentColorLight2">#D9713C</Color>
                    <Color x:Key="SystemAccentColorLight3">#E8A33D</Color>
                    <Color x:Key="SystemAccentColorDark1">#AB5019</Color>
                    <Color x:Key="SystemAccentColorDark2">#8E4113</Color>
                    <Color x:Key="SystemAccentColorDark3">#6E320E</Color>

                    <SolidColorBrush x:Key="LfBackgroundBrush" Color="#141715" />
                    <SolidColorBrush x:Key="LfSurfaceBrush" Color="#1B1F1D" />
                    <SolidColorBrush x:Key="LfSurfaceDeepBrush" Color="#212B33" />
                    <SolidColorBrush x:Key="LfLineBrush" Color="#2C322F" />
                    <SolidColorBrush x:Key="LfHeadingBrush" Color="#B4C6D1" />
                    <SolidColorBrush x:Key="LfEmberBrush" Color="#D9713C" />
                    <SolidColorBrush x:Key="LfSparkBrush" Color="#E8A33D" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E8EBE7" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A9AFAA" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#1B1F1D" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#2C322F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Überschriften wie auf firestrike.de: Serifenschrift (Iowan Old Style → Palatino Linotype unter Windows)  -->
            <FontFamily x:Key="LfSerifFont">Palatino Linotype, Book Antiqua, Georgia</FontFamily>

            <Style x:Key="LfTitleStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LfSerifFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource LfHeadingBrush}" />
            </Style>
            <Style x:Key="LfTitleLargeStyle" BasedOn="{StaticResource TitleLargeTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LfSerifFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource LfEmberBrush}" />
            </Style>
            <Style x:Key="LfSubtitleStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LfSerifFont}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource LfHeadingBrush}" />
            </Style>
            <Style x:Key="LfBookTitleStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LfSerifFont}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
